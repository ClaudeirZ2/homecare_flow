# Copie este arquivo para ".env" e preencha com os seus dados.
# O .env NÃO vai para o GitHub (está no .gitignore), porque tem senha.

# --- Banco de dados MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Se a senha tiver caracteres especiais, coloque entre aspas simples: 'minha,senha'
DB_PASSWORD=sua_senha_aqui
DB_NAME=homecare_flow

# Na nuvem (Aiven) a conexão precisa de SSL:
DB_SSL=false
# Certificado CA do Aiven (opcional, mas recomendado quando DB_SSL=true)
DB_CA_CERT=
# Fuso usado nas datas do MySQL (Brasília)
DB_TIMEZONE=-03:00

# --- Autenticação ---
JWT_SECRET=troque_por_um_segredo_forte_aqui
JWT_EXPIRES_IN=8h

# --- Servidor ---
PORT=5000
# Endereço do front autorizado a chamar a API (ex.: https://homecare-flow.vercel.app)
# Vazio = libera qualquer origem (bom só para desenvolvimento)
CORS_ORIGIN=
